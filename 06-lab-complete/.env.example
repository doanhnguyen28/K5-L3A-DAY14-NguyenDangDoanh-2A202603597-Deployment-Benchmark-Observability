# Copy: cp .env.example .env   (.env nằm trong .gitignore — KHÔNG commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị thật trên platform (Railway/Render), không ghi vào code
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard). Docker Compose tự đặt redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
